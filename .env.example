# ==============================================================================
# AI Virtual Try-On Platform — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL OR PRODUCTION VALUES
# NEVER COMMIT REAL API KEYS OR PRODUCTION PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=chrome-extension://*

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vton_user:vton_password@localhost:5433/vton_db?schema=public

# --- Redis & Job Queue (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- S3 / MinIO Object Storage Configuration ---
# For local dev using MinIO, set S3_ENDPOINT=http://localhost:9000
# For AWS S3 in production, leave S3_ENDPOINT blank or set your custom endpoint
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vton-private
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- JWT Authentication & Security ---
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- AI Provider Configuration ---
# Supported providers: MOCK | FASHN | REPLICATE | IMAGEN
AI_PROVIDER=MOCK

# FASHN.ai (Virtual Try-On API)
FASHN_API_KEY=your_fashn_api_key_here

# Replicate (IDM-VTON / CatVTON)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Google Cloud Vertex AI (Imagen 3)
VERTEX_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Extension Client Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
