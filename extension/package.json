{
  "name": "@vton/extension",
  "version": "1.0.0",
  "private": true,
  "description": "AI Virtual Try-On Chrome Extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "powershell -Command \"Compress-Archive -Path 'dist/*' -DestinationPath 'ai-virtual-try-on-extension.zip' -Force\""
  },
  "dependencies": {
    "@vton/shared": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.312",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
