{
  "name": "ai-virtual-try-on-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Virtual Try-On Chrome Extension & Backend Platform",
  "workspaces": [
    "shared",
    "backend",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
